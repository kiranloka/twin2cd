{
  "name": "forge",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "dev:web": "pnpm --filter @forge/web dev",
    "dev:server": "cargo run -p forge-server",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "rust:build": "cargo build --workspace",
    "rust:test": "cargo test --workspace",
    "rust:check": "cargo check --workspace",
    "check": "pnpm rust:check && turbo check"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
